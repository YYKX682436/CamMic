+} CamMicRingFrame;
+
+static _Atomic(UInt64)                 gCamMicGeneration = 1;
+static atomic_flag                     gCamMicWriterLock = ATOMIC_FLAG_INIT;
+static CamMicRingFrame*                gRingBuffer = NULL;
+
+static void CamMic_ClearRingBuffer(void)
+{
+    if (gRingBuffer == NULL) return;
+    for (UInt32 index = 0; index < kRing_Buffer_Frame_Size; ++index)
+    {
+        atomic_store_explicit(&gRingBuffer[index].sequence, 0, memory_order_seq_cst);
+        atomic_store_explicit(&gRingBuffer[index].generation, 0, memory_order_seq_cst);
+        atomic_store_explicit(&gRingBuffer[index].packedSamples, 0, memory_order_seq_cst);
+    }
+}
+
+static UInt64 CamMic_PackSamples(Float32 left, Float32 right)
+{
+    UInt32 leftBits = 0, rightBits = 0;
+    memcpy(&leftBits, &left, sizeof(leftBits));
+    memcpy(&rightBits, &right, sizeof(rightBits));
+    return ((UInt64)rightBits << 32) | leftBits;
+}
+
+static void CamMic_UnpackSamples(UInt64 packed, Float32* left, Float32* right)
+{
+    UInt32 leftBits = (UInt32)(packed & 0xffffffffULL);
+    UInt32 rightBits = (UInt32)(packed >> 32);
+    memcpy(left, &leftBits, sizeof(*left));
+    memcpy(right, &rightBits, sizeof(*right));
+}
 
 
